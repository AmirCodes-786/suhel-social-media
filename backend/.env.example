PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For local MongoDB: mongodb://127.0.0.1:27017/vibehub
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/vibehub?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/vibehub

# Native JWT Authentication
JWT_SECRET=your-jwt-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d

# Supabase JWT Secret (found in Supabase Dashboard > Project Settings > API > JWT Settings)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Cloudinary Storage Configuration (Optional - falls back to local disk storage if empty)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
